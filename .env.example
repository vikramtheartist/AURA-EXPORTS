# ==============================================================================
# AURA EXPORTS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Central Enquiry Management Destination (Server-Side)
# All website enquiries arrive at this address regardless of source page
ENQUIRY_TO_EMAIL="contact@auraexport.co"

# Authenticated Sender Address (Configured with Resend or SendGrid domain)
EMAIL_FROM="enquiries@auraexport.co"

# Transactional Email Provider API Key (Server-Side Secret - Never expose to client)
# Resend API key (starts with 're_') or SendGrid API key (starts with 'SG.')
EMAIL_PROVIDER_API_KEY="re_sample_api_key_replace_with_live"

# Client-Side Enquiry API Endpoint
# Default is '/api/enquiry' for local dev, Vercel, Netlify, or Cloudflare Pages.
# For standalone backend deployment, set to full URL e.g. "https://api.auraexport.co/api/enquiry"
VITE_ENQUIRY_API_URL="/api/enquiry"

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Strictly zero PII is transmitted to GA4
VITE_GA_MEASUREMENT_ID="G-XFZZ6YW2EJ"

# AI Studio / Service Settings (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://auraexport.co"
